POSTGRES_DB=thermal_kavach
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@db:5432/thermal_kavach
REDIS_URL=redis://redis:6379/0

# Heat-zone pipeline. EE_LST_BAND must contain WBGT in degrees Celsius before
# setting EE_HEAT_VALUE_TYPE=wbgt; ordinary land-surface temperature is rejected.
EE_PROJECT=thermal-kavach
EE_LST_COLLECTION=MODIS/061/MOD11A1
EE_LST_BAND=LST_Day_1km
EE_LST_SCALE=1
EE_LST_OFFSET=0
EE_HEAT_VALUE_TYPE=lst
EE_VECTOR_SCALE=1000
HEAT_ZONES_SCHEDULER_ENABLED=true